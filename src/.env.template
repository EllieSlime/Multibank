# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# ===========================================
# PostgreSQL Database Configuration
# ===========================================
# Format: postgresql+asyncpg://username:password@host:port/database_name
# 
# For Docker (use service name 'db' as hostname):
# PSQL_DSN=postgresql+asyncpg://postgres:postgres@db:5432/postgres
#
# For Local Development (use localhost):
# PSQL_DSN=postgresql+asyncpg://postgres:password@localhost:5432/your_database_name
PSQL_DSN=postgresql+asyncpg://postgres:password@localhost:5432/your_database_name

# ===========================================
# Redis Configuration
# ===========================================
# Format: redis://[password@]host:port/db_number
#
# For Docker (use service name 'redis' as hostname):
# REDIS_DSN=redis://redis:6379/0
#
# For Local Development (use localhost):
# REDIS_DSN=redis://localhost:6379/0
REDIS_DSN=redis://localhost:6379/0

# ===========================================
# Security Configuration
# ===========================================
# JWT Secret Key - Use a strong random string in production
# Generate with: openssl rand -hex 32
SECURITY_JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# JWT Algorithm - Typically HS256, HS384, or HS512
SECURITY_ALGORITHM=HS256

# Access Token Expiration Time (in minutes)
# Example: 60 = 1 hour, 1440 = 24 hours
SECURITY_ACCESS_TOKEN_EXPIRE=60

# Refresh Token Expiration Time (in days)
# Example: 7 = 1 week, 30 = 1 month
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=30
